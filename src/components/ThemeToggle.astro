<button
    id="theme-toggle"
    class="w-8 h-8 -mr-2 flex items-center justify-center"
    aria-label="Switch to dark mode"
    aria-pressed="false"
>
    <!-- Moon icon for light mode -->
    <svg class="w-4 h-4 fill-current dark:hidden" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
            d="M21.53 15.93c-.16-.27-.61-.69-1.73-.49a8.46 8.46 0 01-1.88.13 8.409 8.409 0 01-5.91-2.82 8.068 8.068 0 01-1.44-8.66c.44-1.01.13-1.54-.09-1.76s-.77-.55-1.83-.11a10.318 10.318 0 00-6.32 10.21 10.475 10.475 0 007.04 8.99 10 10 0 002.89.55c.16.01.32.02.48.02a10.5 10.5 0 008.47-4.27c.67-.93.49-1.519.32-1.79z"
        ></path>
    </svg>

    <!-- Sun icon for dark mode -->
    <svg class="w-4 h-4 fill-current hidden dark:block" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
            d="M12 17a5 5 0 100-10 5 5 0 000 10zm0 2a7 7 0 110-14 7 7 0 010 14zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM3.515 4.929l1.414-1.414L7.05 5.636 5.636 7.05 3.515 4.93zM16.95 18.364l1.414-1.414 2.121 2.121-1.414 1.414-2.121-2.121zm2.121-14.85l1.414 1.415-2.121 2.121-1.414-1.414 2.121-2.121zM5.636 16.95l1.414 1.414-2.121 2.121-1.414-1.414 2.121-2.121zM23 11v2h-3v-2h3zM4 11v2H1v-2h3z"
        ></path>
    </svg>
</button>

<script>
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    function storedTheme(): string | null {
        try {
            return localStorage.getItem("theme");
        } catch {
            return null;
        }
    }

    function syncButton() {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        const isDark = root.classList.contains("dark");
        button.setAttribute("aria-pressed", String(isDark));
        button.setAttribute(
            "aria-label",
            isDark ? "Switch to light mode" : "Switch to dark mode"
        );
    }

    function applyTheme(theme: "light" | "dark", persist = true) {
        const isDark = theme === "dark";
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = theme;
        if (persist) {
            try {
                localStorage.setItem("theme", theme);
            } catch {
                /* storage unavailable */
            }
        }
        syncButton();
    }

    // Delegated so the button keeps working after Astro client-side navigation
    const themeWindow = window as Window & { themeListenersReady?: boolean };

    if (!themeWindow.themeListenersReady) {
        themeWindow.themeListenersReady = true;

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element) || !target.closest("#theme-toggle")) return;
            applyTheme(root.classList.contains("dark") ? "light" : "dark");
        });

        // Follow OS changes only while the visitor has not chosen explicitly
        media.addEventListener("change", (event) => {
            if (storedTheme()) return;
            applyTheme(event.matches ? "dark" : "light", false);
        });

        document.addEventListener("astro:after-swap", syncButton);
    }

    syncButton();
</script>
