---
import { ClientRouter } from "astro:transitions";
import BaseHead, {
  type Props as HeadProps,
} from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";

export type Props = HeadProps & { showHeader?: boolean };

const { showHeader = true, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased break-words">
  <head>
    <BaseHead {...head} />
    <ClientRouter />
  </head>
  <body class="bg-main text-main">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:border focus:border-main focus:bg-main focus:text-main"
    >
      Skip to content
    </a>
    <div class="flex flex-col min-h-screen px-4 md:px-8">
      <Nav />
      {showHeader && <Header />}
      <main id="main" tabindex="-1" class="grow w-full max-w-3xl mx-auto">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
