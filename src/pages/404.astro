---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist."
  showHeader={false}
  noindex
>
  <section class="mb-16 sm:mb-24">
    <p class="mb-4 font-serif text-sm italic">Error 404</p>
    <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">
      This page is missing.
    </h1>
    <p class="mt-6 text-lg leading-normal font-serif">
      The link may be broken, or the page may have been moved.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/">Back home</Button>
      <Button href="/resume/">View resume</Button>
    </div>
  </section>
</BaseLayout>
