---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import siteConfig from "../site-config";

const homepage = siteConfig.homepage;
const highlights = homepage?.highlights ?? [];
const work = homepage?.work ?? [];
---

<BaseLayout description={siteConfig.description} image={siteConfig.image}>
  <Hero />

  {
    highlights.length > 0 && (
      <section class="mb-16 sm:mb-24">
        <h2 class="mb-8 font-serif text-xl italic sm:mb-12 sm:text-2xl">
          What I do
        </h2>
        <div class="grid gap-5 sm:grid-cols-3">
          {highlights.map((highlight) => (
            <div class="border border-dashed border-main p-5">
              <h3 class="mb-2 font-serif text-lg leading-snug font-medium">
                {highlight.title}
              </h3>
              <p class="text-sm leading-relaxed text-main/70">
                {highlight.text}
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    work.length > 0 && (
      <section class="mb-16 sm:mb-24">
        <h2 class="mb-8 font-serif text-xl italic sm:mb-12 sm:text-2xl">
          Selected work
        </h2>
        <ul>
          {work.map((item) => (
            <li class="mb-8 border-b border-dashed border-main pb-8 last:mb-0 last:border-0 last:pb-0">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-serif text-xl leading-snug font-medium">
                  {item.title}
                </h3>
                <p class="text-sm italic text-main/70">{item.meta}</p>
              </div>
              <p class="mt-2 text-sm leading-relaxed">{item.description}</p>
              {item.href && (
                <a
                  class="link mt-2 inline-block text-sm"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View on GitHub
                </a>
              )}
            </li>
          ))}
        </ul>
        <div class="mt-10">
          <Button href="/resume/">Full résumé</Button>
        </div>
      </section>
    )
  }

  <section class="mb-16 border border-dashed border-main px-6 py-10 text-center sm:mb-24 sm:px-12 sm:py-14">
    <h2 class="font-serif text-2xl leading-tight font-medium sm:text-3xl">
      Hiring, or just curious?
    </h2>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-main/70">
      My CV covers the rest of the detail — or send a note and I will get back
      to you.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-4">
      <Button href="/resume.pdf" download>Download CV (PDF)</Button>
      <Button href="/contact/">Get in touch</Button>
    </div>
  </section>
</BaseLayout>
