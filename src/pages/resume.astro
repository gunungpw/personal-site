  {
    title: "Daily Work Plan System (RKH)",
    context: "CV. Karya Hidup Sentosa",
    description:
      "Developed a structured Daily Work Plan (RKH / Rencana Kerja Harian) system to manage operator activities, incorporating task listing, operational time tracking, and weekly data reporting to improve efficiency, accountability, and performance monitoring.",
  },
  {
    title: "Scrap and Repair Rate Reduction Initiative",
    context: "CV. Karya Hidup Sentosa",
    description:
      "Led a project to reduce scrap and repair rates in the Tool Making B Section by developing standardized forms, SOPs for reporting, and root cause analysis protocols, achieving documented targets, minimizing defects, and reducing material, cutting tool, and energy costs.",
  },
  {
    title: "Cutting Tools and Sharpening Section",
