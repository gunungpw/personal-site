const sectionTitleClass =
  "mb-4 border-b border-main pb-1.5 font-serif text-xl font-medium uppercase tracking-[0.14em]";
const rowClass =
  "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5";
const certRowClass =
  "grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4";
const dateClass = "shrink-0 text-sm text-main/70";
const bulletListClass = "mt-1.5 list-disc space-y-1 pl-5 leading-7";
---

<BaseLayout
  title="Resume"
  description="Resume of Gunung Pambudi Wibisono — mechanical engineer with experience in production engineering, tool making, machining, and industrial equipment maintenance."
  showHeader={false}
>
  <header class="mb-10 sm:mb-12">
    <h1 class="font-serif text-3xl leading-tight font-medium sm:text-4xl">
      Gunung Pambudi Wibisono
    </h1>
    <p
      class="mt-3 flex flex-col gap-1 text-sm sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2 sm:gap-y-1"
    >
      <span class="text-main/70">Kab. Bogor, Jawa Barat, Indonesia</span>
      <span aria-hidden="true" class="hidden text-main/30 sm:inline">·</span>
      <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <span aria-hidden="true" class="hidden text-main/30 sm:inline">·</span>
      <a class="link" href="https://github.com/gunungpw">github.com/gunungpw</a>
      <span aria-hidden="true" class="hidden text-main/30 sm:inline">·</span>
      <a class="link" href="https://www.linkedin.com/in/gunungpw/"
        >linkedin.com/in/gunungpw</a
      >
      <span aria-hidden="true" class="hidden text-main/30 sm:inline">·</span>
      <a class="link" href="/">gunung.my.id</a>
    </p>
  </header>

  <section>
    <h2 class={sectionTitleClass}>Professional Summary</h2>
    <p class="leading-7 sm:text-justify">{summary}</p>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Work Experience</h2>
    <div class="space-y-6">
      {
        experience.map((job) => (
          <div>
            <div class={rowClass}>
              <h3 class="font-serif text-lg leading-snug font-medium">
                {job.title}
              </h3>
              <p class={dateClass}>{job.dates}</p>
            </div>
            <div class={`${rowClass} mt-0.5`}>
              <p class="text-sm">{job.company}</p>
              <p class="shrink-0 text-sm italic text-main/70">{job.location}</p>
            </div>
            <ul class={bulletListClass}>
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Education</h2>
    <div class="space-y-5">
      {
        education.map((school) => (
          <div>
            <div class={rowClass}>
              <h3 class="font-serif text-base font-medium">
                {school.institution}
              </h3>
              <p class={dateClass}>{school.dates}</p>
            </div>
            <div class={`${rowClass} mt-0.5`}>
              <p class="text-sm italic">{school.degree}</p>
              <p class="shrink-0 text-sm italic text-main/70">
                {school.location}
              </p>
            </div>
            {school.bullets.length > 0 && (
              <ul class={bulletListClass}>
                {school.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Technical Skills</h2>
    <ul class="list-disc space-y-1.5 pl-5 leading-7">
      {
        skills.map((skill) => (
          <li>
            <strong class="font-semibold">{skill.label}:</strong>
            {" "}
            {skill.items}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Selected Projects</h2>
    <div class="space-y-4">
      {
        projects.map((project) => (
          <div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <h3 class="font-serif text-base font-medium">{project.title}</h3>
              <p class="text-sm italic text-main/70">
                {project.href ? (
                  <a class="link" href={project.href}>
                    {project.context}
                  </a>
                ) : (
                  project.context
                )}
              </p>
            </div>
            <p class="mt-1 leading-7 sm:text-justify">{project.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Certifications &amp; Training</h2>
    <div class="space-y-4">
      {
        certifications.map((cert) => (
          <div>
            <div class={certRowClass}>
              <p class="min-w-0">
                <strong class="font-semibold">{cert.name}</strong>,{" "}
                {cert.issuer}
              </p>
              <p class={dateClass}>{cert.date}</p>
            </div>
            <p class="mt-0.5 text-sm leading-6 text-main/70 sm:text-justify">
              {cert.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Awards</h2>
    <ul class="list-disc space-y-1 pl-5 leading-7">
      <li>
        Team Leader, 1st Place, Skilvul Innovation Challenge, AI Competition
        Cycle 2 (National Level), Project: <a
          class="link"
          href="https://github.com/gunungpw/oral-diseases">Senyummu</a
        >.
      </li>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class={sectionTitleClass}>Additional Information</h2>
    <ul class="list-disc space-y-1 pl-5 leading-7">
      <li>
        <strong class="font-semibold">Languages:</strong> Indonesian (active),
        English (active)
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .link {
    @apply underline decoration-dashed decoration-1 underline-offset-2 hover:decoration-solid;
  }
</style>
